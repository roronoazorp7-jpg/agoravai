# ID da aplicação Discord. O comando /rpc do bot mostra este valor.
DISCORD_APPLICATION_ID=cole_o_id_da_aplicacao_aqui

# Textos exibidos no Rich Presence.
RPC_DETAILS=Savagge
RPC_STATE=Explorando o servidor

# Estes nomes só funcionam depois de cadastrar os assets no Developer Portal.
RPC_LARGE_IMAGE=
RPC_LARGE_TEXT=
RPC_SMALL_IMAGE=
RPC_SMALL_TEXT=

# Opcional: uma atividade começa a contar a partir do momento da conexão.
RPC_TIMER=true

# Botões opcionais. O Discord aceita no máximo dois.
RPC_BUTTON_1_LABEL=
RPC_BUTTON_1_URL=
RPC_BUTTON_2_LABEL=
RPC_BUTTON_2_URL=